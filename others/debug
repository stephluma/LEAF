(async () => {
  const get = (cat, ids) => fetch("/platform/projects/api/form/query?q=" +
    encodeURIComponent(JSON.stringify({
      terms: [{ id: "categoryID", operator: "=", match: cat, gate: "AND" },
              { id: "deleted", operator: "=", match: "0", gate: "AND" }],
      joins: [], sort: {}, getData: ids, limit: 500, limitOffset: 0 })),
    { credentials: "same-origin", headers: { Accept: "application/json" } })
    .then(r => r.json()).then(o => Object.values(o));
  const val = (row, id) => {
    const k = "id" + id;
    for (const b of [row.s1, ...Object.keys(row).filter(x => /^s\d+$/.test(x) && x !== "s1").map(x => row[x]), row]) {
      if (b && b[k] != null && String(b[k]).trim() !== "") return String(b[k]).trim();
    }
    return "";
  };
  const KR = [35, 36, 107, 108, 109, 110, 111, 112, 113, 120];
