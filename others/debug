  // ── Academy button state (Start / Continue / Review) ─────────────────────
  // A learner should only ever have one active (non-deleted) record per
  // self-paced category at a time. This inspects the already-loaded
  // requests data (from runQuery/resultSetWithResolved) to decide which
  // state to show for a given category:
  //   - no non-deleted record at all           -> "Start"
  //   - record exists, not yet submitted       -> "Continue" (into it)
  //   - record exists, submitted (complete)    -> "Review" (read-only)
  // Filters by the record's actual categoryID (not just portal
  // membership) since both Academy 101 and 102 share the "learn" portal.
  function findActiveRecordForCategory(recordsObj, categoryID) {
    const records = Object.values(recordsObj).filter(r =>
      r.recordID.includes(portal_learn) &&
      (r.categoryIDs ? r.categoryIDs.includes(categoryID) : true)
    );
    const active = records.filter(r => !(r.deleted > 0)).sort((a, b) => b.date - a.date);
    return active.length ? active[0] : null;
  }

  function findActiveSelfPacedRecord(recordsObj) {
    return findActiveRecordForCategory(recordsObj, CATEGORY_SELF_PACED);
