<!-- ============================================================
     old: /platform/help_library/report.php?a=View_Help_Resource#XXX
     new: /launchpad/#help_library-article-XXX
     ============================================================ -->
<script>
  // window.location.hash includes the leading "#", e.g. "#XXX"
  var articleId = window.location.hash.substring(1);

  if (articleId) {
    window.location.replace("/launchpad/#help_library-article-" + articleId);
  } else {
    // Fallback if no article ID was present in the URL
    window.location.replace("/launchpad/#help_library");
  }
</script>
