<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LEAF Learning Center</title>
  <link rel="stylesheet" href="/platform/designs/files/smarty_styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700;900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #f3f3f3;
      font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
      color: #0f172a;
      min-height: 100vh;
    }

    .skip-link {
      position: absolute;
      left: 16px;
      top: 16px;
      padding: 8px 12px;
      background: #ffffff;
      border: 2px solid #005ea2;
      color: #0f172a;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      transform: translateY(-200%);
      transition: transform 0.15s ease;
      z-index: 1300;
    }
    .skip-link:focus { transform: translateY(0); outline: 3px solid #005ea2; outline-offset: 2px; }

    .td-wrap {
      max-width: 1100px;
      margin: 24px auto;
      padding: 0 20px;
    }

    /* ── Logo ── */
    .td-logo-wrap {
      display: flex;
      justify-content: center;
      margin-bottom: 16px;
    }

    .td-logo {
      height: 120px;
      width: auto;
    }

    .td-title {
      text-align: center;
      font-size: 2rem;
      font-weight: 900;
      color: #1f2933;
      margin-bottom: 8px;
    }

    .td-subtitle {
      text-align: center;
      font-size: 1rem;
      color: #475569;
      margin-bottom: 32px;
    }

    .td-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-bottom: 24px;
    }

    .td-card {
      background: #ffffff;
      border: 1px solid #cfd7e3;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      display: flex;
      flex-direction: column;
    }

    .td-card-head {
      padding: 14px 18px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .td-card-head h2 {
      font-size: 1.15rem;
      font-weight: 900;
      color: #0f172a;
      margin: 0;
    }

    .td-card-icon { font-size: 22px; line-height: 1; }

    .td-card-head--sky  { background: #d9e8f6; border-bottom: 1px solid #aacdec; }
    .td-card-head--blue { background: #aacdec; border-bottom: 1px solid #8fb8db; }
    .td-card-head--teal { background: #5dc0d1; border-bottom: 1px solid #3fa8ba; }

    .td-card-body {
      padding: 16px 18px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .td-card-desc {
      font-size: 0.95rem;
      color: #475569;
      line-height: 1.65;
      flex: 1;
      margin: 0;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      border: 1px solid #cfd7e3;
      padding: 10px 16px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      background: #ffffff;
      color: #0f172a;
      transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.1s ease, border-color 0.1s ease;
      font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    }

    .btn:hover { box-shadow: 0 6px 16px rgba(15, 23, 42, 0.12); }
    .btn:active { transform: translateY(1px); }

    .btn-primary {
      background: #005ea2;
      border: none;
      color: #ffffff !important;
    }

    .btn-primary:hover {
      background: #004a82;
      border: none;
      box-shadow: 0 6px 16px rgba(0, 94, 162, 0.35);
      color: #ffffff !important;
      text-decoration: none;
    }

    .btn:focus-visible { outline: 3px solid #005ea2; outline-offset: 3px; }
    .btn:disabled { opacity: 0.55; cursor: not-allowed; }

    .btn-sm {
      padding: 7px 14px;
      font-size: 0.875rem;
      border-radius: 8px;
    }

    .td-card-body .btn { width: 100%; }

    /* ── Academy rows (Self-Paced Training card: 101 / 102) ── */
    .td-academy-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .td-academy-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 12px;
      border: 1px solid #cfd7e3;
      border-radius: 10px;
      background: #fafcff;
    }

    .td-academy-row--disabled {
      background: #f3f3f3;
      opacity: 0.85;
    }

    .td-academy-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .td-academy-name {
      font-weight: 700;
      font-size: 0.92rem;
      color: #0f172a;
    }

    .td-academy-badge {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 2px 8px;
      border-radius: 999px;
      background: #f1f5f9;
      color: #64748b;
    }

    .td-academy-row .btn {
      width: auto;
      flex-shrink: 0;
      padding: 8px 14px;
      font-size: 0.9rem;
    }

    .td-requests { margin-bottom: 24px; }

    .td-requests-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: #ffffff;
      border: none;
      border-radius: 10px 10px 0 0;
      padding: 0.875rem 1rem;
      font-weight: 700;
      color: #1f2933;
      cursor: pointer;
      font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
      font-size: 1rem;
      border-bottom: 1px solid #cfd7e3;
    }

    .td-requests-toggle:hover { background: #d9e8f6; }
    .td-requests-toggle:focus-visible { outline: 3px solid #005ea2; outline-offset: 3px; }

    .td-requests-toggle-left { display: flex; align-items: center; gap: 10px; }

    .td-toggle-icon {
      transition: transform 0.2s ease;
      font-size: 20px;
    }

    .td-requests-toggle[aria-expanded="true"] .td-toggle-icon {
      transform: rotate(180deg);
    }

    .td-requests-box {
      border: 1px solid #cfd7e3;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
      background: #ffffff;
    }

    .td-requests-panel {
      background: #ffffff;
    }

    .td-requests-panel[hidden] { display: none; }

    .td-status-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .td-status--pending   { background: #fef9c3; color: #854d0e; }
    .td-status--approved  { background: #dcfce7; color: #166534; }
    .td-status--cancelled { background: #f1f5f9; color: #64748b; }

    .td-support {
      background: #ffffff;
      border: 1px solid #cfd7e3;
      border-left: 4px solid #005ea2;
      border-radius: 0 14px 14px 0;
      box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
      padding: 24px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }

    .td-support-text h2 { font-size: 1.15rem; font-weight: 900; color: #1f2933; margin-bottom: 4px; }
    .td-support-text p  { font-size: 0.95rem; color: #475569; margin: 0; line-height: 1.5; }
    .td-support .btn    { white-space: nowrap; flex-shrink: 0; width: auto; }

    .visually-hidden {
      position: absolute !important;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap;
      border: 0;
    }

    .btn-primary .material-symbols-outlined {
      color: #ffffff;
    }

    /* ── Custom Training Requests view ── */
    #grid { padding: 18px; display: flex; flex-direction: column; gap: 28px; }

    .trq-loading, .trq-empty {
      text-align: center;
      padding: 28px 16px;
      color: #475569;
      font-size: 0.95rem;
    }

    .trq-group-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 1rem;
      font-weight: 900;
      color: #1f2933;
      margin-bottom: 12px;
    }

    .trq-group-title .material-symbols-outlined { font-size: 20px; }

    .trq-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .trq-card {
      border: 1px solid #cfd7e3;
      border-radius: 12px;
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      background: #ffffff;
    }

    .trq-card--selfpaced { border-left: 4px solid #aacdec; }
    .trq-card--reg       { border-left: 4px solid #5dc0d1; }

    .trq-card-main { flex: 1 1 260px; min-width: 0; }

    .trq-card-title {
      font-weight: 700;
      color: #0f172a;
      font-size: 0.98rem;
      margin-bottom: 4px;
      overflow-wrap: break-word;
    }

    .trq-card-title a { color: inherit; text-decoration: none; }
    .trq-card-title a:hover { text-decoration: underline; }

    .trq-meta-row {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      font-size: 0.85rem;
      color: #475569;
    }

    .trq-meta-row .material-symbols-outlined {
      font-size: 16px;
      vertical-align: middle;
      margin-right: 3px;
    }

    /* Progress stepper for self-paced items */
    .trq-stepper {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-top: 8px;
    }

    .trq-step {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 0.78rem;
      font-weight: 700;
      color: #94a3b8;
    }

    .trq-step-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #e2e8f0;
      border: 2px solid #cbd5e1;
      flex-shrink: 0;
    }

    .trq-step.is-complete { color: #166534; }
    .trq-step.is-complete .trq-step-dot { background: #22c55e; border-color: #16a34a; }

    .trq-step.is-current { color: #854d0e; }
    .trq-step.is-current .trq-step-dot { background: #facc15; border-color: #eab308; }

    .trq-step-connector {
      width: 18px;
      height: 2px;
      background: #e2e8f0;
    }

    .trq-card-action {
      flex-shrink: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .trq-review-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 14px;
      font-size: 0.85rem;
      font-weight: 700;
      border-radius: 10px;
      border: 1.5px solid #005ea2;
      background: #005ea2;
      color: #ffffff;
      cursor: pointer;
      transition: background 0.15s ease, box-shadow 0.15s ease;
      font-family: 'Source Sans 3', 'Source Sans Pro', sans-serif;
    }

    .trq-review-btn:hover {
      background: #004a82;
      box-shadow: 0 4px 10px rgba(0, 94, 162, 0.25);
    }

    .trq-review-btn:focus-visible {
      outline: 3px solid #005ea2;
      outline-offset: 2px;
    }

    @media (max-width: 780px) {
      .td-logo { height: 96px; }
      .td-grid { grid-template-columns: 1fr; }
      .td-support { flex-direction: column; align-items: flex-start; }
      .td-support .btn { width: 100%; }
      .trq-card { flex-direction: column; align-items: flex-start; }
      .trq-card-action { width: 100%; justify-content: flex-start; }
      .trq-card-action .btn { width: 100%; }
    }

    @media (prefers-reduced-motion: reduce) {
      .btn { transition: none; }
      .btn:active { transform: none; }
    }

    /* ── Self-paced training modal (iframe) ── */
    .tr-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px;
    }
    .tr-modal-overlay.tr-modal-hidden { display: none; }

    .tr-modal-box {
      background: #ffffff;
      border-radius: 14px;
      box-shadow: 0 25px 60px rgba(15, 23, 42, 0.35);
      width: 100%;
      max-width: 1500px;
      height: 95vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .tr-modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: #d9e8f6;
      border-bottom: 1px solid #aacdec;
      flex-shrink: 0;
    }

    .tr-modal-title {
      font-weight: 900;
      font-size: 1rem;
      color: #0f172a;
    }

    .tr-modal-close {
      background: none;
      border: none;
      cursor: pointer;
      color: #1f2933;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      flex-shrink: 0;
    }
    .tr-modal-close:hover { background: rgba(15, 23, 42, 0.08); }
    .tr-modal-close:focus-visible { outline: 3px solid #005ea2; outline-offset: 2px; }

    .tr-modal-body {
      flex: 1;
      position: relative;
      background: #f3f3f3;
    }

    .tr-modal-iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }

    @media (max-width: 780px) {
      .tr-modal-overlay { padding: 0; }
      .tr-modal-box { max-width: none; height: 100vh; border-radius: 0; }
    }
  </style>
</head>
<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <main id="main-content" class="td-wrap" tabindex="-1">

    <div class="td-logo-wrap">
      <img
        src="https://leaf.va.gov/platform/learn/files/learn_logo.png"
        alt="LEAF learn logo"
        class="td-logo"
        width="120"
        height="120"
        oncontextmenu="return false;"
        draggable="false"
      >
    </div>

    <h1 class="td-title">LEAF Learning Center</h1>
    <p class="td-subtitle">Find training, videos, and resources to get the most out of LEAF.</p>

    <div class="td-grid" role="list">

      <!-- Live Training -->
      <div class="td-card" role="listitem">
        <div class="td-card-head td-card-head--sky">
          <span class="td-card-icon material-symbols-outlined" aria-hidden="true">calendar_month</span>
          <h2>Live Training</h2>
        </div>
        <div class="td-card-body">
          <p class="td-card-desc">Join a scheduled session led by a LEAF subject matter expert. Great for new users or teams onboarding.</p>
          <button type="button" class="btn btn-primary" id="registerLiveTrainingBtn" aria-label="Register for Live Training">
            Register for Training
          </button>
        </div>
      </div>

      <!-- Self-Paced Training -->
      <div class="td-card" role="listitem">
        <div class="td-card-head td-card-head--blue">
          <span class="td-card-icon material-symbols-outlined" aria-hidden="true">play_circle</span>
          <h2>Self-Paced Training</h2>
        </div>
        <div class="td-card-body">
          <p class="td-card-desc">Watch recorded LEAF training sessions at any time, on your own schedule. Perfect for independent learning.</p>
          <div class="td-academy-list">
            <div class="td-academy-row">
              <div class="td-academy-info">
                <span class="td-academy-name">LEAF Academy 101</span>
                <span class="td-academy-badge">Self-Paced</span>
              </div>
              <div id="academy101Action">
                <button type="button" class="btn btn-primary" disabled aria-label="Loading LEAF Academy 101 status">…</button>
              </div>
            </div>
            <div class="td-academy-row" id="academy102Row">
              <div class="td-academy-info">
                <span class="td-academy-name">LEAF Academy 102</span>
                <span class="td-academy-badge" id="academy102Badge">Self-Paced</span>
              </div>
              <div id="academy102Action">
                <button type="button" class="btn" disabled aria-label="Loading LEAF Academy 102 status">…</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Help Library -->
      <div class="td-card" role="listitem">
        <div class="td-card-head td-card-head--teal">
          <span class="td-card-icon material-symbols-outlined" aria-hidden="true">menu_book</span>
          <h2>Help Library</h2>
        </div>
        <div class="td-card-body">
          <p class="td-card-desc">Browse step-by-step guides and articles covering key LEAF features. Available anytime, no registration needed.</p>
          <a class="btn btn-primary" href="https://leaf.va.gov/platform/help_library/report.php?a=Search_Help_Library" target="_blank" rel="noopener noreferrer" aria-label="Browse the Help Library (opens in a new tab)">
            Browse Library
            <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px; margin-left:6px;">open_in_new</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Training Requests -->
    <section class="td-requests" aria-labelledby="requests-heading">
      <div class="td-requests-box">
        <button
          class="td-requests-toggle"
          id="requests-heading"
          aria-expanded="true"
          aria-controls="requests-panel"
          onclick="toggleRequestDisplay()"
        >
          <span class="td-requests-toggle-left">
            <span class="material-symbols-outlined" aria-hidden="true" style="font-size:20px;">assignment</span>
            View Your Training Requests
          </span>
          <span class="material-symbols-outlined td-toggle-icon" aria-hidden="true">expand_more</span>
        </button>

        <div id="requests-panel" class="td-requests-panel">
          <div id="search_status"><p class="trq-loading">Searching for records...</p></div>
          <div id="grid"></div>
          <button type="button" id="searchContainer_getMoreResults"
                  class="btn btn-primary" style="display:none; margin: 0 16px 16px; width: calc(100% - 32px);">
            Show More Records
          </button>
        </div>
      </div>
    </section>

    <section class="td-support" aria-labelledby="support-heading">
      <div class="td-support-text">
        <h2 id="support-heading">Can't find what you're looking for?</h2>
        <p>Have a question or need personalized help? Submit a support request and a LEAF team member will follow up with you directly.</p>
      </div>
      <a class="btn btn-primary" href="https://leaf.va.gov/platform/support/report.php?a=LEAF_Start_Request&id=form_ba7de" target="_blank" rel="noopener noreferrer" aria-label="Request support from a LEAF team member (opens in a new tab)">
        Request Support
        <span class="material-symbols-outlined" aria-hidden="true" style="font-size:18px; margin-left:6px;">open_in_new</span>
      </a>
    </section>
  </main>

  <!-- Self-paced training modal -->
  <div class="tr-modal-overlay tr-modal-hidden" id="trModalOverlay">
    <div class="tr-modal-box" role="dialog" aria-modal="true" aria-labelledby="trModalTitle">
      <div class="tr-modal-header">
        <span class="tr-modal-title" id="trModalTitle">Self-Paced Training</span>
        <button type="button" class="tr-modal-close" id="trModalClose" aria-label="Close training window">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
      </div>
      <div class="tr-modal-body">
        <iframe class="tr-modal-iframe" id="trModalIframe" title="Self-Paced Training" src="about:blank"></iframe>
      </div>
    </div>
  </div>

<script>
  // ── Portal identifiers ────────────────────────────────────────────────────
  const portal_service_requests_launchpad = 'service_requests_launchpad';
  const portal_learn                      = 'learn';

  // ── Category / indicator identifiers ─────────────────────────────────────
  const CATEGORY_SELF_PACED     = 'form_488a8'; // LEAF Academy 101
  const CATEGORY_SELF_PACED_102 = 'form_5c266'; // LEAF Academy 102
  const CATEGORY_TRAINING_REG   = 'form_a3df9';
  const INDICATOR_TRAINING_DATE = '64'; // Live training date, lives on the form_a3df9 record

  // Where the standalone training page lives. Loaded inside the modal
  // iframe below — recordID gets appended with "&" since this base URL
  // already has a query param.
  const SELF_PACED_CONTINUE_URL = './report.php?a=TrainingRequest';

  // ── Current user / auth context (resolved by Smarty) ─────────────────────
  const currentUserID = "<!--{$userID|unescape|escape:'quotes'}-->";
  const CSRFToken     = "<!--{$CSRFToken}-->";

  // ── Query filters ─────────────────────────────────────────────────────────
  const requestFilter_launchpad = {
    "terms": [
      { "id": "userID",     "operator": "=", "match": currentUserID, "gate": "AND" },
      { "id": "deleted",    "operator": "=", "match": 0,             "gate": "AND" },
      { "id": "categoryID", "operator": "=", "match": "form_a3df9",  "gate": "AND" }
    ],
    "joins": ["status", "categoryName", "initiatorName"],
    "getData": [INDICATOR_TRAINING_DATE],
    "sort": {}
  };

  const requestFilter_learn = {
    "terms": [
      { "id": "userID",  "operator": "=", "match": currentUserID, "gate": "AND" },
      { "id": "deleted", "operator": "=", "match": 0,             "gate": "AND" }
    ],
    "joins": ["status", "categoryName", "initiatorName"],
    "sort": {}
  };

  // ── State ─────────────────────────────────────────────────────────────────
  let resultSetWithResolved = {};
  let showingMore  = false;
  const maxInitial = 10;

  // ── Toggle (training requests panel) ─────────────────────────────────────
  function toggleRequestDisplay() {
    const toggle  = document.querySelector('.td-requests-toggle');
    const panel   = document.getElementById('requests-panel');
    const expanded = toggle.getAttribute('aria-expanded') === 'true';

    toggle.setAttribute('aria-expanded', String(!expanded));
    panel.hidden = expanded;

    const btn = document.getElementById('searchContainer_getMoreResults');
    if (btn) {
      btn.style.display =
        !showingMore && Object.keys(resultSetWithResolved).length > maxInitial && !expanded
          ? 'block'
          : 'none';
    }
  }

  // ── Query helpers ─────────────────────────────────────────────────────────
  function getRequests(filter, rootURL = '') {
    let query = new LeafFormQuery();
    if (rootURL) query.setRootURL(rootURL);
    query.importQuery(filter);
    return query.execute();
  }

  // ── Formatting helpers ───────────────────────────────────────────────────
  function formatDate(unixSeconds) {
    if (!unixSeconds) return '—';
    const months = ['Jan','Feb','Mar','Apr','May','June','July','Aug','Sept','Oct','Nov','Dec'];
    const date = new Date(unixSeconds * 1000);
    if (isNaN(date.getTime())) return '—';
    const now  = new Date();
    const year = now.getFullYear() !== date.getFullYear() ? ' ' + date.getFullYear() : '';
    return months[date.getMonth()] + ' ' + parseFloat(date.getDate()) + year;
  }

  function escapeHTML(str) {
    const div = document.createElement('div');
    div.textContent = String(str ?? '');
    return div.innerHTML;
  }

  function extractNumericRecordID(compositeID) {
    const match = String(compositeID).match(/^(\d+)_/);
    return match ? match[1] : compositeID;
  }

  // ── Toast (small helper, independent of the training modal) ─────────────
  function showPortalToast(msg, dur = 3000) {
    let toast = document.getElementById('trPortalToast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'trPortalToast';
      toast.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#0f172a;color:#fff;padding:10px 20px;border-radius:8px;font-size:13px;font-weight:600;z-index:3000;opacity:0;transition:opacity .3s;pointer-events:none;';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    requestAnimationFrame(() => { toast.style.opacity = '1'; });
    clearTimeout(toast._hideTimer);
    toast._hideTimer = setTimeout(() => { toast.style.opacity = '0'; }, dur);
  }

