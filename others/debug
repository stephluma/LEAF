  // Generic POST helper matching the pattern used elsewhere in LEAF for
  // FormData-based endpoints (e.g. api/?a=form/new). Wrapped in
  // Promise.resolve() because $.ajax returns a jQuery Deferred/jqXHR,
  // which supports .then()/.catch() but NOT .finally() — native Promise
  // wrapping is needed for .finally() to work in the calling code.
  function postForm(url, formData) {
    return Promise.resolve($.ajax({
      type: 'POST',
      url: url,
      data: formData,
      processData: false,
      contentType: false
    }));
  }

