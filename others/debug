  console.log("Key Results:", krs.length, "| Objectives:", objs.length);
  console.table(KR.map(id => ({
    indicator: id,
    filled: krs.filter(r => val(r, id)).length,
    sample: [...new Set(krs.map(r => val(r, id)).filter(Boolean))].slice(0, 4).join(" | ")
  })));
  const codes = new Set(krs.map(r => val(r, 109)).filter(Boolean));
  const names = new Set(krs.map(r => val(r, 36)).filter(Boolean));
  const links = [...tasks.map(r => val(r, 39)), ...projs.map(r => val(r, 37))].filter(Boolean);
  console.log("Linked tasks/projects:", links.length,
    "| match a KR code(109):", links.filter(l => codes.has(l)).length,
    "| match a KR name(36):", links.filter(l => names.has(l)).length,
    "| sample links:", [...new Set(links)].slice(0, 4));
  console.log("Objective keys:", objs.slice(0, 3).map(r => val(r, 23)),
    "| KR parent keys:", [...new Set(krs.map(r => val(r, 35)))].slice(0, 3));
})();
