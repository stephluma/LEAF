  // ── Status logic (shared) ─────────────────────────────────────────────────
  function getStatusInfo(record) {
    if (record.deleted > 0) {
      return { stage: 'cancelled', label: 'Cancelled', badgeClass: 'td-status--cancelled' };
    }

    if (record.stepID === null && (record.submitted === '0' || record.submitted === 0)) {
      return record.lastStatus === null
        ? { stage: 'not_started', label: 'Not Submitted', badgeClass: 'td-status--pending' }
        : { stage: 'not_started', label: 'Pending Re-submission', badgeClass: 'td-status--pending' };
    }

    if (record.stepID === null) {
      const label = record.lastStatus && record.lastStatus !== '' ? record.lastStatus : 'Approved';
      return { stage: 'complete', label, badgeClass: 'td-status--approved' };
    }

    const label = record.blockingStepID === 0
      ? 'Pending'
      : `Waiting for ${record.stepTitle ?? 'Next Step'}`;
    return { stage: 'in_progress', label, badgeClass: 'td-status--pending' };
  }

  function getSelfPacedStatusInfo(record) {
    if (record.deleted > 0) {
      return { stage: 'cancelled', label: 'Cancelled', badgeClass: 'td-status--cancelled' };
    }
    if (record.submitted > 0) {
      return { stage: 'complete', label: 'Completed', badgeClass: 'td-status--approved' };
    }
    return { stage: 'in_progress', label: 'In Progress', badgeClass: 'td-status--pending' };
  }

  function recordTitle(record, isSelfPaced) {
    if (record.title && record.title !== 'Record') return record.title;
    return isSelfPaced ? 'Self-Paced Training' : 'Training Registration';
  }

  function recordURL(recordID, isLaunchpad) {
    const portalURL = isLaunchpad
      ? 'https://leaf.va.gov/platform/service_requests_launchpad/'
      : 'https://leaf.va.gov/platform/learn/';
    return `${portalURL}index.php?a=printview&recordID=${parseInt(recordID)}`;
  }

  // ── Card builders ─────────────────────────────────────────────────────────
  function buildStepper(stage) {
    const steps = [
      { key: 'in_progress', label: 'In Progress' },
      { key: 'complete',    label: 'Completed'   }
    ];
    const order = ['in_progress', 'complete'];
    const currentIdx = order.indexOf(stage);

    return `<div class="trq-stepper" role="img" aria-label="Status: ${steps[Math.max(currentIdx,0)].label}">
      ${steps.map((s, i) => {
        let cls = '';
        if (i < currentIdx) cls = 'is-complete';
        else if (i === currentIdx) cls = stage === 'complete' ? 'is-complete' : 'is-current';
        const connector = i < steps.length - 1 ? '<span class="trq-step-connector"></span>' : '';
        return `<span class="trq-step ${cls}"><span class="trq-step-dot"></span>${s.label}</span>${connector}`;
      }).join('')}
    </div>`;
  }

  function buildSelfPacedCard(record) {
    const status = getSelfPacedStatusInfo(record);
    const title  = recordTitle(record, true);
    const url    = recordURL(record.recordID, false);
    const numericID = extractNumericRecordID(record.recordID);

    let actionHTML;
    if (status.stage === 'cancelled') {
      actionHTML = `<span class="td-status-badge td-status--cancelled">Cancelled</span>`;
    } else if (status.stage === 'complete') {
      actionHTML = `
        <span class="td-status-badge td-status--approved">
          <span class="material-symbols-outlined" style="font-size:15px;margin-right:4px;">check_circle</span>Completed
        </span>
        <button type="button" class="trq-review-btn" data-recordid="${escapeHTML(numericID)}">
          Review
        </button>`;
    } else {
      actionHTML = `<button type="button" class="btn btn-primary btn-sm trq-continue-btn"
        data-recordid="${escapeHTML(numericID)}">
        Continue
      </button>`;
    }

    return `
      <div class="trq-card trq-card--selfpaced">
        <div class="trq-card-main">
          <div class="trq-card-title"><a href="${url}" target="_blank">${escapeHTML(title)}</a></div>
          <div class="trq-meta-row">
            <span><span class="material-symbols-outlined">event</span>Date Started: ${formatDate(record.date)}</span>
          </div>
          ${status.stage === 'cancelled' ? '' : buildStepper(status.stage)}
        </div>
        <div class="trq-card-action">${actionHTML}</div>
      </div>
    `;
  }

  function buildRegistrationCard(record) {
    const status = getStatusInfo(record);
    const title  = recordTitle(record, false);
    const url    = recordURL(record.recordID, true);
    const numericID = extractNumericRecordID(record.recordID);
    // Indicator 64 (Session Dates) is a RADIO field whose stored value is
    // already a plain, pre-formatted display string (e.g. "Oct. 7, 2026")
    // — one of a fixed set of session-date options, not a timestamp. Use
    // it directly rather than trying to parse/format it.
    const trainingDate = record.s1?.id64 ?? '—';

    const isSubmitted = record.submitted > 0;
    let actionHTML;
    if (status.stage === 'cancelled' || status.stage === 'complete') {
      actionHTML = `<span class="td-status-badge ${status.badgeClass}">${escapeHTML(status.label)}</span>`;
    } else if (isSubmitted) {
      // Submitted but still moving through an approval workflow step —
      // there's nothing left for the registrant to "continue," so show
      // a pending badge instead of an actionable button.
      actionHTML = `<span class="td-status-badge td-status--pending">Pending</span>`;
    } else {
      actionHTML = `<button type="button" class="btn btn-primary btn-sm trq-continue-reg-btn" data-recordid="${escapeHTML(numericID)}">Continue</button>`;
    }

    return `
      <div class="trq-card trq-card--reg">
        <div class="trq-card-main">
          <div class="trq-card-title"><a href="${url}" target="_blank">${escapeHTML(title)}</a></div>
          <div class="trq-meta-row">
            <span><span class="material-symbols-outlined">calendar_month</span>Training Date: ${trainingDate}</span>
          </div>
        </div>
        <div class="trq-card-action">${actionHTML}</div>
      </div>
    `;
  }

  // ── Render ────────────────────────────────────────────────────────────────
  function renderResult(recordsObj) {
    const grid = document.getElementById('grid');
    const records = Object.values(recordsObj);

    if (records.length === 0) {
      grid.innerHTML = `<p class="trq-empty">No Pending Requests</p>`;
      return;
    }

    const selfPaced = records
      .filter(r => r.recordID.includes(portal_learn))
      .sort((a, b) => b.date - a.date);

    const registrations = records
      .filter(r => r.recordID.includes(portal_service_requests_launchpad))
      .sort((a, b) => b.date - a.date);

    let html = '';

    html += `
      <div class="trq-group">
        <div class="trq-group-title">
          <span class="material-symbols-outlined" aria-hidden="true">play_circle</span>
          Self-Paced Learning
        </div>
        <div class="trq-list">
          ${selfPaced.length
            ? selfPaced.map(buildSelfPacedCard).join('')
            : '<p class="trq-empty">No self-paced requests yet.</p>'}
        </div>
      </div>
    `;

    html += `
      <div class="trq-group">
        <div class="trq-group-title">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>
          Live Training Registrations
        </div>
        <div class="trq-list">
          ${registrations.length
            ? registrations.map(buildRegistrationCard).join('')
            : '<p class="trq-empty">No live training registrations yet.</p>'}
        </div>
      </div>
    `;

    grid.innerHTML = html;

    // Re-bind Continue buttons every render, since grid.innerHTML wipes
    // out any previously attached listeners.
    grid.querySelectorAll('.trq-continue-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        goToSelfPacedRecord(btn.dataset.recordid, false);
      });
    });

    grid.querySelectorAll('.trq-review-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        goToSelfPacedRecord(btn.dataset.recordid, true);
      });
    });

    grid.querySelectorAll('.trq-continue-reg-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        openTrainingModal(`${LIVE_TRAINING_REGISTRATION_URL}&recordID=${encodeURIComponent(btn.dataset.recordid)}`, 'Live Training Registration');
      });
    });
  }

  function runQuery() {
    Promise.all([
      getRequests(requestFilter_launchpad, `/platform/${portal_service_requests_launchpad}/`),
      getRequests(requestFilter_learn,     `/platform/${portal_learn}/`)
    ]).then(results => {
      const resultsArray = [];

      const serviceResults = results[0];
      for (let rec in serviceResults) {
        serviceResults[rec].recordID = `${rec}_${portal_service_requests_launchpad}`;
        resultSetWithResolved[`${rec}_${portal_service_requests_launchpad}`] = serviceResults[rec];
        resultsArray.push(serviceResults[rec]);
      }

      const learnResults = results[1];
      for (let rec in learnResults) {
        learnResults[rec].recordID = `${rec}_${portal_learn}`;
        resultSetWithResolved[`${rec}_${portal_learn}`] = learnResults[rec];
        resultsArray.push(learnResults[rec]);
      }

      resultsArray.sort((a, b) => (a.date > b.date ? -1 : a.date < b.date ? 1 : 0));

      const sliced = resultsArray.slice(0, maxInitial);
      const initialRecords = {};
      sliced.forEach(el => initialRecords[el.recordID] = el);

      const btn = document.getElementById('searchContainer_getMoreResults');
      if (btn && Object.keys(resultSetWithResolved).length > maxInitial) {
        btn.style.display = 'block';
      }

      renderResult(initialRecords);
      renderAcademy101Action(resultSetWithResolved);
      renderAcademy102Action(resultSetWithResolved);
      document.querySelector('#search_status').innerHTML = '';

    }).catch(err => {
      console.error('Error retrieving requests:', err);
      document.querySelector('#search_status').innerHTML =
        `<p class="trq-empty">We couldn't load your training requests right now.</p>`;
    });
  }

  // ── Boot ──────────────────────────────────────────────────────────────────
  function main() {
    runQuery();

    const moreResultsEl = document.getElementById('searchContainer_getMoreResults');
    if (moreResultsEl !== null) {
      moreResultsEl.addEventListener('click', function() {
        renderResult(resultSetWithResolved);
        moreResultsEl.style.display = 'none';
        showingMore = true;
      });
    }

    const modalCloseBtn = document.getElementById('trModalClose');
    if (modalCloseBtn !== null) {
      modalCloseBtn.addEventListener('click', closeSelfPacedModal);
    }

    const registerLiveTrainingBtn = document.getElementById('registerLiveTrainingBtn');
    if (registerLiveTrainingBtn !== null) {
      registerLiveTrainingBtn.addEventListener('click', startLiveTrainingRegistration);
    }

    const modalOverlay = document.getElementById('trModalOverlay');
    if (modalOverlay !== null) {
      modalOverlay.addEventListener('click', function(e) {
        if (e.target === modalOverlay) closeSelfPacedModal();
      });
    }

    document.addEventListener('keydown', function(e) {
      const overlay = document.getElementById('trModalOverlay');
      if (e.key === 'Escape' && overlay && !overlay.classList.contains('tr-modal-hidden')) {
        closeSelfPacedModal();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', main);
</script>

</body>
</html>
