/**
 * DELETE REQUEST IN LEAF
 * 
 * HTTP Method: DELETE
 * Endpoint: /api/request/{recordID}
 * Alternative: /api/form/{recordID}/cancel
 * 
 * REQUIRED PARAMETERS:
 * - recordID (integer): The ID of the request to delete
 * - CSRFToken (string): Required security token, pass as query parameter
 * 
 * CLIENT-SIDE EXAMPLE (JavaScript/jQuery):
 * 
 * $.ajax({
 *     type: 'DELETE',
 *     url: '/api/request/' + recordID + '?' + $.param({'CSRFToken': CSRFToken}),
 *     success: function(response) {
 *         // response will be 1 on success or error message on failure
 *         if (response == 1) {
 *             console.log('Request deleted successfully');
 *         } else {
 *             alert('Error: ' + response);
 *         }
 *     },
 *     error: function(err) {
 *         console.log('Delete failed', err);
 *     }
 * });
 * 
 * SERVER-SIDE (PHP):
 * 
 * The deletion is handled by Form::cancelRecord() in LEAF_Request_Portal/sources/Form.php
 * 
 * Method signature:
 * public function cancelRecord(int $recordID, ?string $comment = '', bool $suppressNotification = false): int|string
 * 
 * What it does:
 * 1. Validates user permissions (admins or request initiators with allowRequestorCancel enabled)
 * 2. Soft-deletes the record by setting deleted timestamp
 * 3. Logs the deletion action to action_history with actionID 4
 * 4. Clears workflow state (records_workflow_state)
 * 5. Clears tags associated with record
 * 6. Sends notification emails to prior approvers (unless suppressNotification = true)
 * 
 * Returns:
 * - 1 on success
 * - Error string on failure (permission denied, etc.)
 * 
 * ALSO AVAILABLE:
 * permanentlyDeleteRecord($recordID) - Completely removes all data for a record (admin only)
 * restoreRecord($recordID) - Un-deletes a soft-deleted request (admin only)
 * 
 * DATABASE TABLES AFFECTED:
 * - records (sets deleted timestamp)
 * - action_history (logs deletion action)
 * - records_workflow_state (cleared)
 * - tags (cleared)
 * - records_dependencies (cleared)
 */
