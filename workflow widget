<div id="calAccessRequest">
  <div class="cal-ar-card">
    <span class="cal-ar-icon material-icons" aria-hidden="true">lock</span>
    <h1>Access Required</h1>
    <p class="cal-ar-desc">
      The Team Command Center calendar is limited to those who need to know.<br />
      If this applies to you, click below to submit an access request.
    </p>
    <button type="button" class="cal-ar-btn" id="calArOpenBtn">
      Request Access
    </button>
  </div>
</div>

<div
  id="calArModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="calArModalTitle"
>
  <div class="cal-ar-modal-box">
    <div class="cal-ar-modal-header">
      <h2 class="cal-ar-modal-title" id="calArModalTitle">
        Request Calendar Access
      </h2>
      <button
        type="button"
        class="cal-ar-modal-close"
        id="calArCloseBtn"
        aria-label="Close"
      >
        <span class="material-icons" aria-hidden="true">close</span>
      </button>
    </div>
    <iframe
      id="calArFrame"
      class="cal-ar-modal-frame"
      title="Access Request Form"
      src="about:blank"
      sandbox="allow-forms allow-scripts allow-same-origin allow-popups"
    ></iframe>
  </div>
</div>

<script>
  (function () {
    var FORM_URL =
      "https://leaf.va.gov/platform/calendar/report.php?a=LEAF_Start_Request&id=form_32bbf&title=Calendar+Access+Request&iframe=1";

    var openBtn = document.getElementById("calArOpenBtn");
    var closeBtn = document.getElementById("calArCloseBtn");
    var modal = document.getElementById("calArModal");
    var frame = document.getElementById("calArFrame");

    function suppressHeader() {
      try {
        var doc =
          frame.contentDocument ||
          (frame.contentWindow && frame.contentWindow.document);
        if (!doc || !doc.head) return;
        if (doc.getElementById("cal-ar-header-suppress")) return;

        var style = doc.createElement("style");
        style.id = "cal-ar-header-suppress";
        style.textContent = [
          "header#header,",
          "#header,",
          "#footer,",
          "#nav-skip-link,",
          "footer { display: none !important; }",
          "body, main#body, #content, #bodyarea {",
          "  margin-top: 0 !important;",
          "  padding-top: 0 !important;",
          "}",
        ].join("\n");
        doc.head.appendChild(style);

        var ids = ["header", "footer", "nav-skip-link"];
        ids.forEach(function (id) {
          var el = doc.getElementById(id);
          if (el) el.style.setProperty("display", "none", "important");
        });
      } catch (e) {}
    }

    function openModal() {
      frame.src = FORM_URL;
      modal.classList.add("is-open");
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    }

    function closeModal() {
      modal.classList.remove("is-open");
      document.body.style.overflow = "";
      frame.src = "about:blank";
      openBtn.focus();
    }

    frame.addEventListener("load", suppressHeader);

    openBtn.addEventListener("click", openModal);
    closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", function (e) {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && modal.classList.contains("is-open"))
        closeModal();
    });
  })();
</script>
